{
  "name": "pos-sitekoom-menu",
  "version": "1.0.0",
  "private": true,
  "description": "POS-SITEKOOM QR Menu & Table Ordering platform (multi-restaurant), integrated with the offline-first POS.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "e2e:setup": "tsx --conditions=react-server scripts/e2e-setup.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo-google-fonts/noto-kufi-arabic": "^0.4.3",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
