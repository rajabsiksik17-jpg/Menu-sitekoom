# POS-SITEKOOM Menu platform — copy to .env (never commit the real .env).

# Public origin used in table QR links and returned to the POS (no trailing slash).
PUBLIC_BASE_URL=https://menu.sitekoom.com

# PostgreSQL connection (production). Leave empty in development to use the embedded database in DATA_DIR/pglite.
DATABASE_URL=postgres://menu:CHANGE_ME@db:5432/menu
DB_SSL=false
DB_POOL_SIZE=10
# Run migrations automatically when the server starts (or run `npm run db:migrate` during deployment and set false).
AUTO_MIGRATE=true

# Uploaded images (and the development database). Must be a persistent volume in production.
DATA_DIR=/data

# At least 32 random characters: openssl rand -base64 48
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# First platform administrator, created at start only if none exists (remove the password afterwards).
ADMIN_EMAIL=owner@sitekoom.com
ADMIN_NAME=Sitekoom
ADMIN_PASSWORD=

# HTTPS cookies (true behind HTTPS) and trusting X-Forwarded-For from the reverse proxy.
SECURE_COOKIES=true
TRUST_PROXY=true

# Map tiles and address search for the restaurant location editor (server-side; keys never reach the browser).
# Defaults: OpenStreetMap tiles + Nominatim (fine for low admin traffic; use a commercial provider for heavy use).
# MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_TILES_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=POS-SITEKOOM-Menu/1.0 (contact@sitekoom.com)

# Docker compose only: database password and the domain Caddy requests a certificate for.
POSTGRES_PASSWORD=CHANGE_ME
MENU_DOMAIN=menu.sitekoom.com
